NODE_ENV=production
PORT=3000
API_PREFIX=/api/v1

# Railway MySQL: map these to the values exposed by your MySQL service.
DB_HOST=${MYSQLHOST}
DB_PORT=${MYSQLPORT}
DB_USER=${MYSQLUSER}
DB_PASSWORD=${MYSQLPASSWORD}
DB_NAME=${MYSQLDATABASE}
DB_CONNECTION_LIMIT=20
DB_QUEUE_LIMIT=200
DB_CONNECT_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=60000

# Generate unique random values; never use the defaults from source.
JWT_ACCESS_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET=CHANGE_THIS_TO_A_DIFFERENT_LONG_RANDOM_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
AUTH_COOKIE_NAME=tecump_refresh
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax

# Same-origin deployment: use your Railway/custom HTTPS URL.
# If more than one trusted frontend origin is used, separate them with commas.
CORS_ORIGIN=https://YOUR-RAILWAY-DOMAIN.up.railway.app

# Optional email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=TUMCU Christian Union <tumchristianunion@gmail.com>

# Uploads. Attach a Railway Volume to /app/data/uploads for persistence.
UPLOAD_DIR=/app/data/uploads

# Currently reserved for future Redis-backed jobs; the app does not require Redis for core operation.
REDIS_URL=redis://localhost:6379
