NODE_ENV=production
PORT=3000
API_PREFIX=/api/v1

# TUMCU production environment
# Copy to .env on the deployment server and replace every placeholder.

DB_NAME=tecump
DB_USER=tecump
DB_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_THIS_TO_A_DIFFERENT_LONG_RANDOM_PASSWORD

JWT_ACCESS_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_REFRESH_EXPIRES_IN=30d
AUTH_COOKIE_NAME=tecump_refresh
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax
UPLOAD_DIR=/app/data/uploads

# The public URL of the site, for example https://tumcu.example.org
CORS_ORIGIN=https://YOUR-TUMCU-DOMAIN

# Optional SMTP settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=TUMCU Christian Union <tumchristianunion@gmail.com>
# For real email delivery configure Gmail SMTP with an App Password:
# SMTP_HOST=smtp.gmail.com
# SMTP_USER=tumchristianunion@gmail.com
# SMTP_PASSWORD=<Gmail App Password>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
AUTH_COOKIE_NAME=tecump_refresh
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax
