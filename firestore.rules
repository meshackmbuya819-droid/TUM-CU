rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && request.auth.token.email == 'meshackokoth436@gmail.com';
    }

    function isAdmin() {
      return isSignedIn() && (isBootstrappedAdmin() || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Test connection check for boot verification
    match /test/{docId} {
      allow get: if true;
    }

    // Admin registry
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId);
      allow list: if isAdmin();
      allow write: if isAdmin() && isValidId(adminId);
    }

    // User profiles
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidId(userId) && isOwner(userId);
      allow update: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Prayer requests
    match /prayerRequests/{requestId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(requestId) && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(requestId) && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && isValidId(requestId) && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
