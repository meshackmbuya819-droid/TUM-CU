# Server & Security
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-at-least-32-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
AUTH_COOKIE_NAME=tecump_refresh
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=tecump
DB_PASSWORD=
DB_NAME=tecump
DB_CONNECTION_LIMIT=20
DB_QUEUE_LIMIT=200
DB_CONNECT_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=60000

# Redis / future distributed state
REDIS_URL=redis://localhost:6379

# AI / Capabilities
GEMINI_API_KEY=

# Optional Email / Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=TUMCU Christian Union <tumchristianunion@gmail.com>
# For real email delivery configure Gmail SMTP with an App Password:
# SMTP_HOST=smtp.gmail.com
# SMTP_USER=tumchristianunion@gmail.com
# SMTP_PASSWORD=<Gmail App Password>
NOTIFICATION_DISPATCH_INTERVAL_MS=30000
